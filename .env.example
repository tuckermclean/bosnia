# Copy this file to `.env` and fill in the values for the features you use.
# Everything here is SERVER-SIDE (backend / content / voice-agent). The mobile
# app's public config lives in app/.env.example — never put secret keys there.
# Local dev/test needs NONE of these: the backend runs on in-process PGlite and
# the AI features degrade gracefully when their keys are absent.

# ── Backend ─────────────────────────────────────────────────────────────
# Postgres connection string for production/staging. Leave blank for local
# dev/test, which uses an in-process PGlite database (no server required).
DATABASE_URL=

# Optional: directory for a FILE-BACKED PGlite DB (local/manual E2E only).
# Lets `npm run seed` and `npm run dev` share one on-disk DB across runs.
# Unset => in-memory PGlite (same as tests). Ignored when DATABASE_URL is set.
PGLITE_PATH=

# JWT signing secrets. The dev defaults below work for local PGlite mode ONLY;
# in any non-local mode (DATABASE_URL set) the server REFUSES to boot unless
# these are replaced with long random strings.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

PORT=3000

# ── Groq (pronunciation STT: whisper-large-v3 / -turbo) ─────────────────
GROQ_API_KEY=

# ── Azure Neural TTS (bs-BA reference audio: Vesna / Goran) ─────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: override the default Bosnian voice (default: bs-BA-VesnaNeural).
AZURE_TTS_VOICE=

# ── LiveKit (real-time voice tutor transport) ───────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Tutor / content LLM (brain — need not be Claude) ────────────────────
# Provider is pluggable; set whichever you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
