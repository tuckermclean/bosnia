# Ljiljan mobile app — PUBLIC config only.
# Expo inlines EXPO_PUBLIC_* vars into the client bundle at build time, so they
# are NOT secret. Never put API keys here — those live server-side (see root
# .env.example). Copy this to app/.env for local dev.

# Base URL of the Ljiljan backend the app talks to.
# Defaults to http://localhost:3000 if unset (see src/api/config.ts).
# On a physical device use your machine's LAN IP, e.g. http://192.168.1.10:3000.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
