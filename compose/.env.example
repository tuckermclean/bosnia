# Copy to compose/.env and fill in. compose/.env is ignored by git.

# --- Postgres ---------------------------------------------------------------
# Credentials of the stack's own database. Use a password of letters and digits
# only (it sits inside DATABASE_URL), e.g. `openssl rand -hex 24`.
POSTGRES_USER=bosanski
POSTGRES_DB=bosanski
POSTGRES_PASSWORD=

# --- Backend ----------------------------------------------------------------
# JWT secrets: at least 32 characters, random. The backend refuses to boot on
# these placeholders. Make each with `openssl rand -hex 32`.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARS
# Groq (grading of recordings, tutor). Leave empty to run without it.
GROQ_API_KEY=
# Azure Speech (text to speech). Leave empty to run without it.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- LiveKit Cloud (backend token minting and the voice agent) ---------------
# The voice agent exits without these three.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Voice agent, optional (see voice-agent/README.md) -----------------------
# AZURE_TTS_VOICE=bs-BA-VesnaNeural
# STT_PROVIDER=groq
# LLM_PROVIDER=groq
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-4.1-mini
# TUTOR_DEFAULT_LEVEL=A1
# BACKEND_TURNS_URL=
# BACKEND_TURNS_TOKEN=

# --- Web (Caddy) --------------------------------------------------------------
# Public DNS name pointing at this host (Caddy gets a certificate for it), or
# `localhost` for Caddy's local certificate. Baked into the web image: after a
# change run `docker compose build web`.
DOMAIN=localhost

# Basic auth over every path except /health: `on` or `off`. A test stack on a
# public address has open registration, so consider `on`.
# Exactly "on" or "off" (any other value stops Caddy from starting).
BASIC_AUTH=off
BASIC_AUTH_USER=
# bcrypt hash: `docker run --rm caddy:2 caddy hash-password` (it asks for the
# password). Write each `$` in the hash as `$$` here, because Compose reads `$`
# in an env file as interpolation.
BASIC_AUTH_HASH=
