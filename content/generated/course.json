        {
          "id": "a1-u1-s2",
          "order": 2,
          "title": "Predstavljanje",
          "titleEn": "Introductions",
          "grammarTip": "Present tense of 'biti' (to be): ja sam, ti si, on/ona/ono je, mi smo, vi ste, oni/one su. Bosnian also uses reflexive verbs with 'se' — 'zvati se' (to be called): 'Kako se zoveš?' / 'Zovem se...'. Keep the informal/formal split in mind: 'zoveš' (ti) vs 'zovete' (vi).",
          "reviewStatus": "unreviewed",
          "vocab": [
            {
              "bs": "Ja sam...",
              "en": "I am...",
              "audioHash": "f9fc7c780237a1f0fbbd7f257f3e9dd674a4f1fed2bb5f1b0ba629236466478a"
            },
            {
              "bs": "Kako se zoveš?",
